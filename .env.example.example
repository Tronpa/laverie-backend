# ============================================================
#  LAVERIE DU PARC — Variables d'environnement
#  Renommer ce fichier en .env et remplir toutes les valeurs
# ============================================================

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=laverie_db
DB_USER=postgres
DB_PASSWORD=Mot2passe86.

# JWT Secret (choisir une longue chaîne aléatoire)
JWT_SECRET=LaverieSecretSuperLong2024AbcXyz!
JWT_EXPIRES_IN=30d

# Port du serveur
PORT=3000

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+33xxxxxxxxx

# Google Maps API
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rayon de livraison en km
RAYON_MAX_KM=10

# Coordonnées de la laverie (à renseigner avec votre adresse)
LAVERIE_LATITUDE=48.8566
LAVERIE_LONGITUDE=2.3522

# Firebase (notifications push)
# Chemin vers le fichier JSON téléchargé depuis Firebase Console
FIREBASE_CREDENTIALS_PATH=./config/firebase-credentials.json

# Environnement
NODE_ENV=development
